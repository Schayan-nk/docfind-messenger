# docfind-messenger: every setting is an environment variable. Copy this file
# to .env beside the binary (or name it with -env-file) and fill in what you
# use. Real variables in the environment win over this file unless
# -env-file-wins is given. Never commit the filled-in copy.

# ---------------------------------------------------------------- database
# PostgreSQL holds chats, accounts, notifications and the audit trail. The
# schema is created and upgraded on start.
DOCFIND_PG_HOST=127.0.0.1
DOCFIND_PG_PORT=5432
DOCFIND_PG_USER=messenger
DOCFIND_PG_PASSWORD=change-me
DOCFIND_PG_DATABASE=messenger
# disable | require | verify-ca | verify-full
DOCFIND_PG_SSLMODE=disable
# Queries slower than this many milliseconds are logged.
#DOCFIND_SLOW_QUERY_MS=500

# ---------------------------------------------------------------- HTTPS
# Serve TLS directly. Leave unset behind a reverse proxy that terminates TLS
# and passes WebSocket upgrades. Browsers allow the camera and microphone only
# on a secure page, so calls need one or the other.
#DOCFIND_TLS_CERT=/etc/messenger/fullchain.pem
#DOCFIND_TLS_KEY=/etc/messenger/privkey.pem

# ---------------------------------------------------------------- passkeys
# The host name passkeys are bound to. A passkey belongs to this name for
# good: change it and every registered passkey stops working.
#DOCFIND_PASSKEY_RPID=chat.example.com
# The origins pages are served from, comma separated, each https on that host.
#DOCFIND_PASSKEY_ORIGINS=https://chat.example.com

# ---------------------------------------------------------------- calls
# The built-in STUN and TURN server. Off unless the secret is set; calls
# between networks that cannot reach each other need it. A long random value.
#DOCFIND_TURN_SECRET=
# The name browsers reach the relay at (default: the page's own host), and its ports.
#DOCFIND_TURN_HOST=chat.example.com
#DOCFIND_TURN_PORT=3478
#DOCFIND_TURN_TLS_PORT=5349
#DOCFIND_TURN_TLS_CERT=
#DOCFIND_TURN_TLS_KEY=
# Where relays are announced (this machine's first private IPv4 by default)
# and the UDP port range they use.
#DOCFIND_TURN_RELAY_IP=
#DOCFIND_TURN_RELAY_PORTS=49160-49359
# Group calls: the built-in media server, UDP and TCP. "off" turns group
# calls off.
#DOCFIND_SFU=on
#DOCFIND_SFU_PORT=3479

# ---------------------------------------------------------------- files
# Where chat files are kept (by their SHA-256). Default: beside the accounts
# file. An administrator can also choose it in Settings.
#DOCFIND_CHAT_MEDIA=/var/lib/messenger/media
# A static ffmpeg build, for video thumbnails and voice waveforms.
#DOCFIND_FFMPEG=/usr/local/bin/ffmpeg
# 1 lets people send executable files. Refused by default.
#DOCFIND_CHAT_ALLOW_EXECUTABLES=0

# ---------------------------------------------------------------- notifications
# Web Push to phones and desktops. Push services need an address to reach
# you at; without one, device notifications stay off.
DOCFIND_PUSH_SUBJECT=mailto:admin@example.com
# "off" turns device notifications off.
#DOCFIND_PUSH=on
# Extra push-service hosts, comma separated, for a browser whose push service
# is not one of the four known ones.
#DOCFIND_PUSH_HOSTS=

# ---------------------------------------------------------------- sign-in codes
# Two-step sign-in by email: a mailbox to send the codes from. Port 465 is TLS
# from the start, 587 is STARTTLS; nothing is sent over a plain connection.
#DOCFIND_SMTP_HOST=smtp.example.com
#DOCFIND_SMTP_PORT=465
#DOCFIND_SMTP_USERNAME=codes@example.com
#DOCFIND_SMTP_PASSWORD=
#DOCFIND_SMTP_FROM=codes@example.com
# Two-step sign-in by SMS, and resetting a forgotten password by SMS. The
# panel's REST API (the default URL is Asanak's).
#DOCFIND_SMS_URL=
#DOCFIND_SMS_USERNAME=
#DOCFIND_SMS_PASSWORD=
#DOCFIND_SMS_API_KEY=
# The sender number, in international form without the plus.
#DOCFIND_SMS_FROM=

# ---------------------------------------------------------------- maps
# A shared location is drawn from map tiles this server fetches and caches.
# The provider's URL template, or "off" for a plain grid. Default:
# OpenStreetMap, whose tile policy asks for a contact in the request.
#DOCFIND_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#DOCFIND_MAP_CONTACT=admin@example.com

# ---------------------------------------------------------------- translation
# A Translate button between Persian, English and German, answered by a
# self-hosted Ollama model. Hidden unless both are set.
#DOCFIND_CHAT_TRANSLATE_URL=http://127.0.0.1:11434
#DOCFIND_CHAT_TRANSLATE_MODEL=qwen2.5:7b

# ---------------------------------------------------------------- logs
# Default: a logs folder beside the accounts file.
#DOCFIND_LOG_DIR=
#DOCFIND_LOG_KEEP_DAYS=30
#DOCFIND_LOG_MAX_DAY_MB=200
